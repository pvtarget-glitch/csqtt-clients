#!/bin/sh
# csqttd для Keenetic с Entware: /opt/etc/init.d/S99csqttd {start|stop|restart|status}
#
# Если в /opt/etc/csqtt/autoconnect записано имя профиля, после запуска
# службы туннель поднимается сам (подходит для загрузки роутера).

PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=/opt/etc/csqtt/csqttd.toml
LOG=/opt/var/log/csqttd.log
PIDFILE=/opt/var/run/csqttd.pid
SOCKET=/opt/var/run/csqtt/csqttd.sock
AUTOCONNECT=/opt/etc/csqtt/autoconnect
export HOME=/opt/root

running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if running; then
        echo "csqttd уже запущен"
        return 0
    fi
    [ -c /dev/net/tun ] || {
        echo "нет /dev/net/tun: установи компонент KeeneticOS с модулем tun (например, «Клиент OpenVPN»)"
        return 1
    }
    mkdir -p /opt/var/log /opt/var/run/csqtt
    csqttd --config "$CONFIG" >>"$LOG" 2>&1 &
    echo $! >"$PIDFILE"
    i=0
    while [ ! -S "$SOCKET" ] && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
    if ! running; then
        echo "csqttd не запустился, см. $LOG"
        return 1
    fi
    echo "csqttd запущен"
    if [ -s "$AUTOCONNECT" ]; then
        profile="$(head -n 1 "$AUTOCONNECT")"
        # Подключение может ждать капчу или сеть — не держим загрузку.
        (sleep 5; csqtt up "$profile" >>"$LOG" 2>&1) &
        echo "подключение профиля «$profile» запущено в фоне"
    fi
}

stop() {
    if ! running; then
        echo "csqttd не запущен"
        csqttd --config "$CONFIG" --cleanup >/dev/null 2>&1
        return 0
    fi
    kill -TERM "$(cat "$PIDFILE")"
    i=0
    while running && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
    running && kill -KILL "$(cat "$PIDFILE")"
    csqttd --config "$CONFIG" --cleanup >/dev/null 2>&1
    rm -f "$PIDFILE"
    echo "csqttd остановлен"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status)
        if running; then csqtt status; else echo "csqttd не запущен"; exit 1; fi
        ;;
    *) echo "использование: $0 {start|stop|restart|status}"; exit 2 ;;
esac
