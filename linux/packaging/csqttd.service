[Unit]
Description=csqtt tunnel daemon (TUN, routing, core supervisor)
Documentation=https://github.com/amurcanov/csqtt
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/csqttd
# Снять правила и интерфейс, даже если демон убит или упал.
ExecStopPost=/usr/sbin/csqttd --cleanup
Restart=on-failure
RestartSec=3
# SIGTERM получает только демон: он сам корректно останавливает ядро.
KillMode=mixed
TimeoutStopSec=25
RuntimeDirectory=csqtt
RuntimeDirectoryMode=0755

# Демону нужны: сеть (TUN, маршруты), смена UID для ядра, сигналы ядру,
# запись в /proc/sys и (без systemd-resolved) в /etc/resolv.conf.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=true
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
