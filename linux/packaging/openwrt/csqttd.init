#!/bin/sh /etc/rc.common
# csqttd для OpenWrt (procd): /etc/init.d/csqttd {start|stop|restart|enable|disable}
#
# Если в /etc/csqtt/autoconnect записано имя профиля, после запуска службы
# туннель поднимается сам (подходит для загрузки роутера).

START=99
STOP=10
USE_PROCD=1

CONFIG=/etc/csqtt/csqttd.toml
AUTOCONNECT=/etc/csqtt/autoconnect

start_service() {
    [ -c /dev/net/tun ] || {
        echo "нет /dev/net/tun: установи kmod-tun" >&2
        return 1
    }
    mkdir -p /var/run/csqtt
    procd_open_instance
    procd_set_param command /usr/sbin/csqttd --config "$CONFIG"
    procd_set_param env HOME=/root
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_started() {
    [ -s "$AUTOCONNECT" ] || return 0
    profile="$(head -n 1 "$AUTOCONNECT")"
    # Подключение может ждать сеть — не держим загрузку.
    (sleep 5; /usr/bin/csqtt up "$profile" 2>&1 | logger -t csqtt) &
}

stop_service() {
    /usr/sbin/csqttd --config "$CONFIG" --cleanup >/dev/null 2>&1
}
