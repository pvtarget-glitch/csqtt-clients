# Пакет из готовых бинарников (scripts/build-rpm-arch.sh): сборки нет,
# %install копирует подготовленное дерево.
Name:           csqtt
Version:        @VERSION@
Release:        1
Summary:        Linux client for the csqtt tunnel
License:        PolyForm-Noncommercial-1.0.0
URL:            https://github.com/pvtarget-glitch/csqtt-clients
BuildArch:      @ARCH@
Requires:       (iproute or iproute2)
Requires(post): systemd
Requires(preun): systemd
Requires(postun): systemd
Recommends:     nftables
Recommends:     curl
Recommends:     polkit
Recommends:     python3-gobject
Recommends:     (webkit2gtk4.1 or typelib-1_0-WebKit2-4_1)
Recommends:     (libayatana-appindicator-gtk3 or libayatana-appindicator3-1)
Recommends:     libnotify
Conflicts:      csqtt-linux

%global __os_install_post %{nil}
%global debug_package %{nil}
%global _build_id_links none

%description
Daemon (csqttd), desktop window (csqtt-gui), command-line tool (csqtt)
and manual captcha window for the csqtt TURN/RTP tunnel. Runs the csqtt
core @CORE_VERSION@ as an unprivileged subprocess and provides the Linux
side: TUN interface, policy routing, DNS, per-application bypass and
process supervision.

Non-commercial use only (PolyForm Noncommercial 1.0.0, as the core).

%install
cp -a @TREE@/. %{buildroot}/

%files
%license /usr/share/doc/csqtt/copyright
%doc /usr/share/doc/csqtt/README.md
%dir /etc/csqtt
%config(noreplace) /etc/csqtt/csqttd.toml
/usr/bin/csqttd
/usr/bin/csqtt
/usr/bin/csqtt-gui
/usr/lib/csqtt
/usr/lib/systemd/system/csqttd.service
/usr/lib/systemd/user/csqtt-agent.service
/usr/lib/sysusers.d/csqtt.conf
/usr/share/applications/csqtt.desktop
/usr/share/icons/hicolor/*/apps/csqtt.*
/usr/share/csqtt

%post
systemd-sysusers /usr/lib/sysusers.d/csqtt.conf >/dev/null 2>&1 || :
for user in "${SUDO_USER:-}" "$(id -nu "${PKEXEC_UID:-x}" 2>/dev/null)"; do
    if [ -n "$user" ] && [ "$user" != root ] && id "$user" >/dev/null 2>&1; then
        id -nG "$user" | tr ' ' '\n' | grep -qx csqtt || usermod -aG csqtt "$user" || :
    fi
done
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable csqttd.service >/dev/null 2>&1 || :
    if [ "$1" -gt 1 ]; then
        systemctl try-restart csqttd.service >/dev/null 2>&1 || :
    else
        systemctl start csqttd.service >/dev/null 2>&1 || :
        echo "csqtt: чтобы управлять туннелем, добавь себя в группу: sudo usermod -aG csqtt \$USER"
    fi
fi

%preun
if [ "$1" -eq 0 ] && [ -d /run/systemd/system ]; then
    systemctl disable --now csqttd.service >/dev/null 2>&1 || :
fi

%postun
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
fi
